    "discord.js": "^14.16.3",
    "electron-updater": "^6.3.9",
    "express": "^4.22.3",
    "ffmpeg-static": "^5.2.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.1",
